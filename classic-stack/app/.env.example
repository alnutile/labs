APP_NAME="Classic Stack"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8080
APP_PORT=8080
LOG_CHANNEL=stderr
LOG_LEVEL=debug
DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=classic_stack
DB_USERNAME=classic_stack
DB_PASSWORD=local-only-change-me
SESSION_DRIVER=redis
SESSION_SECURE_COOKIE=false
CACHE_STORE=redis
QUEUE_CONNECTION=redis
REDIS_CLIENT=predis
REDIS_HOST=redis
REDIS_PORT=6379
MAIL_MAILER=log
ALLOW_REGISTRATION=true
HORIZON_ALLOWED_EMAILS=

# Local Neuron computer-agent experiment. Never add API keys to this example.
AGENT_ENABLED=false
AGENT_PROVIDER=openai
AGENT_MODEL=gpt-5.2
AGENT_API_KEY=
OPENAI_API_KEY=
AGENT_BROKER_URL=http://agent-broker:8010
# Generated in app/.env by ./scripts/agent up:
AGENT_BROKER_TOKEN=
