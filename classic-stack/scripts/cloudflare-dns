#!/usr/bin/env python3
"""Upsert the lab A record; token is read from the environment, never Terraform state."""
import json
import os
import sys
import urllib.parse
import urllib.request
import ipaddress
host = "classic-stack.dailyai.studio"
address = str(ipaddress.IPv4Address(sys.argv[1])) if len(sys.argv) == 2 else sys.exit("Usage: scripts/cloudflare-dns ELASTIC_IP")
zone = os.environ["CLOUDFLARE_ZONE_ID"]
token = os.environ["CLOUDFLARE_API_TOKEN"]
base = f"https://api.cloudflare.com/client/v4/zones/{zone}/dns_records"
def request(method, url, data=None):
    req = urllib.request.Request(url, data=None if data is None else json.dumps(data).encode(), method=method,
        headers={"Authorization": f"Bearer {token}", "Content-Type": "application/json"})
    with urllib.request.urlopen(req, timeout=30) as response:
        body = json.load(response)
    if not body.get("success"):
        raise RuntimeError("Cloudflare rejected the DNS request")
    return body["result"]
records = request("GET", base + "?" + urllib.parse.urlencode({"name": host}))
if len(records) > 1 or (records and records[0]["type"] != "A"):
    sys.exit("Conflicting DNS records exist; inspect them before continuing.")
# Start DNS-only so Caddy can obtain its origin certificate. Enable proxy afterward.
data = {"type": "A", "name": host, "content": address, "ttl": 1,
        "proxied": records[0]["proxied"] if records else False}
request("PUT" if records else "POST", base + ("/" + records[0]["id"] if records else ""), data)
print(f"{host} → {address}; proxied={data['proxied']}")
