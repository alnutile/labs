APP_NAME="Classic Stack"
APP_ENV=production
APP_KEY=GENERATE_ONCE_WITH_PHP_ARTISAN_KEY_GENERATE_SHOW
APP_DEBUG=false
APP_URL=https://classic-stack.dailyai.studio
APP_DOMAIN=classic-stack.dailyai.studio
LOG_CHANNEL=stderr
LOG_LEVEL=info
DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=classic_stack
DB_USERNAME=classic_stack
DB_PASSWORD=REPLACE_WITH_RANDOM_PASSWORD
SESSION_DRIVER=redis
SESSION_SECURE_COOKIE=true
CACHE_STORE=redis
QUEUE_CONNECTION=redis
REDIS_CLIENT=predis
REDIS_HOST=redis
REDIS_PORT=6379
MAIL_MAILER=log
ALLOW_REGISTRATION=false
HORIZON_ALLOWED_EMAILS=YOUR_EMAIL_ADDRESS
